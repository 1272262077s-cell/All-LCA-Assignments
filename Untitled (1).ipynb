    "#add two matrices using numpy\n",
    "import numpy as np\n",
    "\n",
    "# Matrix A\n",
    "A = np.array([[1, 2],\n",
    "              [3, 4]])\n",
    "\n",
    "# Matrix B\n",
    "B = np.array([[5, 6],\n",
    "              [7, 8]])\n",
    "result = A + B\n",
    "\n",
    "# Output\n",
    "print(\"Result (NumPy):\")\n",
    "print(result)"
   ]
