    "#greatest of three numbers\n",
    "a = 30\n",
    "b = 40\n",
    "c = 50\n",
    "if a>=b and a>=c : \n",
    "    print(\"greatest=\" , a)\n",
    "elif b>=a and b>=c :\n",
